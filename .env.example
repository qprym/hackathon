# Demo mode never calls an LLM. All seeded materials are explicitly synthetic.
DEMO_MODE=true
SEED_DEMO=true
DEMO_PASSWORD=demo-alfa-2026
DATABASE_URL=postgresql+psycopg://alfa:alfa-local@db:5432/alfa
POSTGRES_PASSWORD=alfa-local
COOKIE_SECURE=false
INLINE_WORKER=false
AUTO_FETCH_RSS=true
RSS_REFRESH_SECONDS=1800
RSS_ITEM_LIMIT=50
LLM_BASE_URL=
# Admin UI "Настройки LLM" can override connection fields without restarting.
# Saved credentials live in the server runtime_settings volume, never in Git.
LLM_PROVIDER_MODE=remote
LLM_LOCAL_API_KEY=
LLM_TIMEOUT_SECONDS=180
# Local weights/config revision invalidates cached selections after a model change.
LLM_MODEL_REVISION=
# Technical input envelope; whole articles are never cut to fit.
LLM_CONTEXT_CHARACTERS=120000
JOB_LEASE_SECONDS=90
# Local mode: OpenAI-compatible server, e.g. http://host.docker.internal:8001/v1
# No paid request/ruble quota and no client max_tokens cap in local mode by default.
LLM_API_KEY=
# Fill exact provider IDs for these approved display names; never use another model.
LLM_ANALYSIS_MODEL=Qwen3.6 35B A3B
LLM_ANALYSIS_ID=
LLM_EXTRACTION_MODEL=Gemma 4 26B A4B
LLM_EXTRACTION_ID=
# Remote API only: prices must be confirmed. Paid calls fail closed while prices are 0.
LLM_INPUT_RUB_PER_MILLION=0
LLM_OUTPUT_RUB_PER_MILLION=0
LLM_DAILY_LIMIT_RUB=450
# Shared lifetime allowance for this trial. Includes errors and all agent stages.
# Default 20; raise only after explicit authorization. Never reset the database counter.
LLM_REQUEST_LIMIT=20
# Confirm a total test budget before enabling live mode. Zero blocks all paid calls.
LLM_TEST_LIMIT_RUB=0
LLM_BUDGET_TIMEZONE=Europe/Moscow
# Processes explicitly queued selection batches; merely reading a feed makes no paid call.
NEURAL_RANKING_WORKER=false
# Automatic source -> assessment -> full feed chain. Effective only in local mode.
AUTO_PERSONALIZATION=false
ACTIVE_COMPANY_IDS=U_26491,U_989,U_6923
PIPELINE_INTERVAL_SECONDS=60
PREVIEW_CACHED_ONLY=false
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
