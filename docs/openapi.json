  "components": {
    "schemas": {
      "Analyze": {
        "properties": {
          "company_id": {
            "type": "string",
            "title": "Company Id"
          },
          "event_id": {
            "type": "string",
            "title": "Event Id"
          },
          "role": {
            "type": "string",
            "enum": [
              "CEO",
              "CFO",
              "TREASURER"
            ],
            "title": "Role",
            "default": "CFO"
          }
        },
        "type": "object",
        "required": [
          "company_id",
          "event_id"
        ],
        "title": "Analyze"
      },
      "Body_upload_csv_api_admin_import_csv_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          },
          "synthetic": {
            "type": "boolean",
            "title": "Synthetic",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_csv_api_admin_import_csv_post"
      },
      "Body_upload_pdf_api_admin_import_pdf_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "published_at": {
            "type": "string",
            "format": "date-time",
            "title": "Published At"
          },
          "synthetic": {
            "type": "boolean",
            "title": "Synthetic",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "file",
          "title",
          "published_at"
        ],
        "title": "Body_upload_pdf_api_admin_import_pdf_post"
      },
      "FeedbackInput": {
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "useful",
              "irrelevant",
              "factual_error"
            ],
            "title": "Category"
          },
          "comment": {
            "type": "string",
            "maxLength": 2000,
            "title": "Comment",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "category"
        ],
        "title": "FeedbackInput"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Login": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "Login"
      },
      "NewsInput": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 500,
            "minLength": 5,
            "title": "Title"
          },
          "content": {
            "type": "string",
            "maxLength": 100000,
            "minLength": 60,
            "title": "Content"
          },
          "publisher": {
            "type": "string",
            "maxLength": 200,
            "minLength": 2,
            "title": "Publisher"
          },
          "url": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2083,
                "minLength": 1,
                "format": "uri"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          },
          "published_at": {
            "type": "string",
            "format": "date-time",
            "title": "Published At"
          },
          "kind": {
            "type": "string",
            "enum": [
              "news",
              "bank"
            ],
            "title": "Kind",
            "default": "news"
          },
          "synthetic": {
            "type": "boolean",
            "title": "Synthetic",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "title",
          "content",
          "publisher",
          "published_at"
        ],
        "title": "NewsInput"
      },
      "Question": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 3,
            "title": "Question"
          }
        },
        "type": "object",
        "required": [
          "question"
        ],
        "title": "Question"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}